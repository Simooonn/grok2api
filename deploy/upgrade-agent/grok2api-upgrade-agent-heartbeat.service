[Unit]
Description=Refresh grok2api upgrade agent heartbeat
After=docker.service

[Service]
Type=oneshot
User=root
Environment=PROJECT_DIR=@PROJECT_DIR@
Environment=CONTROL_DIR=@CONTROL_DIR@
Environment=STATE_DIR=@STATE_DIR@
Environment=IMAGE_REPO=@IMAGE_REPO@
ExecStart=/usr/bin/python3 /usr/local/sbin/grok2api-upgrade-agent.py heartbeat
